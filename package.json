{
  "name": "aisleforge",
  "private": true,
  "description": "AisleForge — Intelligent Retail Fulfillment & Resilience Platform",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project db",
    "test:kafka": "vitest run --project kafka",
    "test:all": "vitest run",
    "test:e2e": "pnpm --filter @aisleforge/web build && playwright test",
    "db:init": "tsx tools/seed/init-db.ts",
    "seed": "tsx tools/seed/seed.ts",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "migrate": "tsx packages/database/src/cli/migrate.ts",
    "invariants": "tsx packages/database/src/cli/invariants.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@aisleforge/api": "workspace:*",
    "@aisleforge/cache": "workspace:*",
    "@aisleforge/database": "workspace:*",
    "@aisleforge/domain": "workspace:*",
    "@aisleforge/events": "workspace:*",
    "@aisleforge/routing": "workspace:*",
    "@aisleforge/shared": "workspace:*",
    "@aisleforge/validation": "workspace:*",
    "@aisleforge/worker": "workspace:*",
    "@confluentinc/kafka-javascript": "1.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.49.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.7.0-beta.19",
    "esbuild": "0.24.2",
    "eslint": "^9.39.1",
    "express": "^5.3.0",
    "fast-check": "^4.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
