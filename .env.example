# AisleForge configuration. Copy to .env for local runs. Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://aisleforge:change-me@localhost:5432/aisleforge

# Connection budget per process — see docs/deployment/CONNECTION_BUDGET.md
PG_ORDERS_POOL_MAX=10
PG_SYNC_POOL_MAX=5
PG_WORKER_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=2000
PG_STATEMENT_TIMEOUT_MS=5000
PG_LOCK_TIMEOUT_MS=2000
PG_IDLE_IN_TX_TIMEOUT_MS=10000
PG_TX_MAX_ATTEMPTS=4

RESERVATION_TTL_MINUTES=30
MAX_ORDER_LINES=50
MAX_LINE_QTY=1000

# Tests: point the db test project at an existing PostgreSQL instead of the embedded one (e.g. in CI).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aisleforge_test

# API (Phase 3). JWT_SECRET: >= 32 random characters, never committed. The API refuses to start without it.
PORT=8080
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_WINDOW_SECONDS=300
